---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { mockUser } from '../data/mockData';
---

<Layout title="Withdraw Partial PF">
  <Header />
  
  <main class="partial-claim-container container">
    <div class="page-header">
      <div class="breadcrumbs">
        <a href="/dashboard">Dashboard</a> &gt; <span>Withdraw Partial PF</span>
      </div>
      <h1>Withdraw Partial PF (Form-31)</h1>
      <p class="text-muted">Apply for an advance for illness, education, marriage, or housing.</p>
    </div>

    <div class="split-layout">
      <!-- Form Section -->
      <div class="form-section card">
        <div id="claim-form-container">
          
          <div class="form-group">
            <label for="purpose">Purpose of Advance</label>
            <select id="purpose" class="form-select">
              <option value="" disabled selected>Select Purpose</option>
              <option value="illness">Illness</option>
              <option value="marriage">Marriage</option>
              <option value="education">Higher Education</option>
              <option value="house">Purchase of House/Flat</option>
              <option value="natural-calamity">Natural Calamity</option>
            </select>
          </div>

          <div class="form-group amount-group mt-6">
            <label for="amount">Amount of Advance Required (in ₹)</label>
            <div class="amount-input-wrapper">
              <span class="currency-symbol">₹</span>
              <input type="number" id="amount" class="form-control" placeholder="Enter amount" />
            </div>
            
            <div class="ai-boost-section mt-3">
              <button class="btn btn-sm ai-boost-btn" id="ai-max-amount-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                AI Boost: Auto-fill Max Eligible Amount
              </button>
              <p class="help-text mt-1" id="ai-amount-help" style="display: none;">
                Based on your current balance and selected purpose, the max eligible advance is <strong>₹ <span id="calculated-max"></span></strong> (75% of your PF share).
              </p>
            </div>
          </div>

          <div class="employee-address-section mt-8">
            <div class="section-header-row">
              <h3>Employee Address</h3>
              <button class="btn btn-sm btn-outline ai-boost-btn-small" id="ai-fill-address-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                Import from KYC
              </button>
            </div>
            
            <div class="address-grid mt-4">
              <div class="form-group">
                <label for="locality">Locality / Street</label>
                <input type="text" id="locality" class="form-control" />
              </div>
              <div class="form-group">
                <label for="city">City</label>
                <input type="text" id="city" class="form-control" />
              </div>
              <div class="form-group">
                <label for="state">State</label>
                <input type="text" id="state" class="form-control" />
              </div>
              <div class="form-group">
                <label for="pincode">PIN Code</label>
                <input type="text" id="pincode" class="form-control" />
              </div>
            </div>
          </div>
          
          <div class="document-upload-section mt-8">
            <h3>Upload Documents</h3>
            <p class="text-sm text-muted mb-4">Upload a scanned copy of a cancelled cheque or passbook.</p>
            
            <div class="upload-area" id="upload-area">
              <div class="upload-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                <p>Drag & Drop or Click to Browse</p>
                <span class="text-xs text-muted">Max file size 500KB (JPG/PDF)</span>
              </div>
            </div>
            
            <div class="ai-boost-section text-center mt-3">
              <span class="text-muted text-sm mx-2">OR</span>
              <button class="btn btn-sm ai-boost-btn" id="digilocker-sync-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                AI Boost: Bypass upload via DigiLocker Sync
              </button>
            </div>
          </div>

          <div class="actions mt-8 pt-6 border-t border-gray-200">
            <button class="btn btn-outline" onclick="window.history.back()">Cancel</button>
            <button class="btn btn-primary" id="submit-claim-btn">Submit Claim Application</button>
          </div>
        </div>
        
        <!-- Success State -->
        <div id="success-state" style="display: none;" class="success-container">
          <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <h2>Advance Claim Submitted!</h2>
          <p class="text-muted mt-2">Your Form-31 application has been successfully submitted to the EPFO.</p>
          
          <div class="tracking-info mt-6 mb-8">
            <span class="tracking-label">Tracking ID</span>
            <span class="tracking-value" style="font-family: monospace; font-size: 1.25rem; font-weight: bold; color: var(--primary);">CLM-2026-ADV99X</span>
          </div>

          <div class="mt-8">
            <a href="/track-claim" class="btn btn-primary w-full text-center block">Track Claim Status</a>
          </div>
        </div>
      </div>
      
      <!-- Info Section -->
      <aside class="info-section">
        <div class="info-card card">
          <h4><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg> Rules for Advance</h4>
          <ul class="info-list">
            <li><strong>Illness:</strong> Up to 6 months basic wages or employee share with interest, whichever is less.</li>
            <li><strong>Marriage/Education:</strong> Up to 50% of employee share (Requires 7 years membership).</li>
            <li><strong>Housing:</strong> Up to 36 months basic wages or total accumulation, whichever is less.</li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<script define:vars={{ mockUser }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Read state
    let userStr = localStorage.getItem('epfMockUser');
    if (!userStr) {
      localStorage.setItem('epfMockUser', JSON.stringify(mockUser));
      userStr = JSON.stringify(mockUser);
    }
    const currentUser = JSON.parse(userStr);
    const activeAccount = currentUser.memberIds[0]; // Assume current account for calculation
    
    const formContainer = document.getElementById('claim-form-container');
    const successState = document.getElementById('success-state');
    const purposeSelect = document.getElementById('purpose');
    const amountInput = document.getElementById('amount');
    const aiMaxBtn = document.getElementById('ai-max-amount-btn');
    const aiAmountHelp = document.getElementById('ai-amount-help');
    const calculatedMaxSpan = document.getElementById('calculated-max');
    
    const aiFillAddressBtn = document.getElementById('ai-fill-address-btn');
    const digilockerSyncBtn = document.getElementById('digilocker-sync-btn');
    const uploadArea = document.getElementById('upload-area');
    const submitBtn = document.getElementById('submit-claim-btn');
    
    // AI Max Amount Calculation
    aiMaxBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!purposeSelect.value) {
        alert("Please select a purpose for the advance first.");
        return;
      }
      
      // Calculate 75% of Employee + Employer share
      const totalShare = activeAccount.totalEmployeeShare + activeAccount.totalEmployerShare;
      const maxEligible = Math.floor(totalShare * 0.75);
      
      amountInput.value = maxEligible;
      calculatedMaxSpan.textContent = maxEligible.toLocaleString('en-IN');
      aiAmountHelp.style.display = 'block';
      
      // Visual feedback
      amountInput.style.borderColor = 'var(--primary)';
      amountInput.style.backgroundColor = 'var(--primary-light)';
      setTimeout(() => {
        amountInput.style.backgroundColor = '';
      }, 1000);
    });
    
    // AI Fill Address
    aiFillAddressBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('locality').value = 'Flat 402, Green View Apartments, MG Road';
      document.getElementById('city').value = 'Mumbai';
      document.getElementById('state').value = 'Maharashtra';
      document.getElementById('pincode').value = '400001';
      
      // Visual feedback
      const inputs = ['locality', 'city', 'state', 'pincode'];
      inputs.forEach(id => {
        const el = document.getElementById(id);
        el.style.borderColor = 'var(--primary)';
        el.style.backgroundColor = 'var(--primary-light)';
        setTimeout(() => {
          el.style.backgroundColor = '';
        }, 1000);
      });
      aiFillAddressBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Synced from KYC';
      aiFillAddressBtn.classList.add('text-success');
      aiFillAddressBtn.disabled = true;
    });
    
    // DigiLocker Sync
    digilockerSyncBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      uploadArea.innerHTML = `
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--success);">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <p class="font-semibold" style="color: var(--success); font-weight: 600;">Bank Details Synced via DigiLocker</p>
          <span class="text-sm">HDFC Bank ends in 8912</span>
        </div>
      `;
      uploadArea.style.borderColor = 'var(--success)';
      uploadArea.style.backgroundColor = 'var(--success-bg)';
      digilockerSyncBtn.style.display = 'none';
    });
    
    // Submit
    submitBtn?.addEventListener('click', () => {
      if (!purposeSelect.value || !amountInput.value || !document.getElementById('city').value) {
        alert("Please fill in all required fields or use the AI Boosts.");
        return;
      }
      
      // Simulate submission
      formContainer.style.display = 'none';
      successState.style.display = 'block';
      window.scrollTo(0, 0);
    });
  });
</script>

<style>
  .partial-claim-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  
  .page-header {
    margin-bottom: 2rem;
  }
  
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  
  .breadcrumbs a {
    color: var(--primary);
  }
  
  .split-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  
  .form-section {
    padding: 2.5rem;
  }
  
  .form-group {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-main);
  }
  
  .form-control, .form-select {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.2s;
    width: 100%;
  }
  
  .form-control:focus, .form-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-light);
  }
  
  .amount-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .currency-symbol {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  .amount-input-wrapper input {
    padding-left: 2.5rem;
  }
  
  .ai-boost-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .ai-boost-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .ai-boost-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  
  .ai-boost-btn-small {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }
  
  .help-text {
    font-size: 0.75rem;
    color: var(--success);
    background: var(--success-bg);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
  
  .section-header-row h3 {
    font-size: 1.125rem;
    color: var(--text-main);
  }
  
  .address-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .address-grid .form-group:first-child {
    grid-column: span 2;
  }
  
  .upload-area {
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 3rem 2rem;
    text-align: center;
    background: var(--background);
    transition: all 0.2s;
    cursor: pointer;
  }
  
  .upload-area:hover {
    border-color: var(--primary);
    background: var(--primary-light);
  }
  
  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-muted);
  }
  
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }
  
  .info-card {
    padding: 1.5rem;
    background: var(--surface);
  }
  
  .info-card h4 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-main);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  
  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .info-list li {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.5rem;
  }
  
  .info-list li::before {
    content: "•";
    color: var(--primary);
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1.25rem;
    line-height: 1.2;
  }
  
  .success-container {
    text-align: center;
    padding: 3rem 1rem;
  }
  
  .success-icon {
    width: 80px;
    height: 80px;
    background: var(--success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  
  .text-danger { color: var(--danger); }
  .text-success { color: var(--success); }
  .mt-1 { margin-top: 0.25rem; }
  .mt-2 { margin-top: 0.5rem; }
  .mt-3 { margin-top: 0.75rem; }
  .mt-4 { margin-top: 1rem; }
  .mt-6 { margin-top: 1.5rem; }
  .mt-8 { margin-top: 2rem; }
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .pt-6 { padding-top: 1.5rem; }
  .mx-2 { margin-left: 0.5rem; margin-right: 0.5rem; }
  .block { display: block; }
  .border-t { border-top-width: 1px; }
  .border-gray-200 { border-color: var(--border); }
</style>
