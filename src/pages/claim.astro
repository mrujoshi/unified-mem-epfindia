---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { mockUser } from '../data/mockData';
---

<Layout title="1-Click Online Claim">
  <Header />
  
  <main class="claim-container container">
    <div class="page-header">
      <div class="breadcrumbs">
        <a href="/dashboard">Dashboard</a> &gt; <span>1-Click Claim</span>
      </div>
      <h1>AI-Assisted PF Withdrawal</h1>
      <p class="text-muted">Your intent: "Withdraw my PF". We've prepared everything for you.</p>
    </div>

    <div class="card digilocker-card" id="claim-form-state">
       <div class="digilocker-header">
         <div class="dl-icon">
           <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
         </div>
         <h3>DigiLocker Verified Data</h3>
       </div>
       
       <div class="data-grid">
         <div class="data-item">
           <span class="data-label">Aadhaar</span>
           <span class="data-value">
             <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
             Verified (**** **** 1234)
           </span>
         </div>
         <div class="data-item">
           <span class="data-label">Bank Account</span>
           <span class="data-value">
             <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
             HDFC Bank (Ends in 8912)
           </span>
         </div>
         <div class="data-item">
           <span class="data-label">Claim Type</span>
           <span class="data-value">Full Final Settlement (Form-19)</span>
         </div>
       </div>

       <div class="amount-card">
         <span class="amount-label">Estimated Withdrawal Amount</span>
         <span class="amount-value">₹ 2,45,000</span>
       </div>

       <div class="action-section">
         <p class="text-sm text-muted mb-4">By clicking confirm, you authorize EPFO to fetch your e-KYC from DigiLocker and process this claim automatically. No document uploads required.</p>
         <button class="btn btn-primary btn-large w-full" id="one-click-submit">
           Confirm & Submit Claim
         </button>
       </div>
    </div>

    <!-- Success State -->
    <div class="card success-step" id="success-state" style="display: none;">
      <div class="success-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h2>Claim Submitted Successfully!</h2>
      <p class="text-muted mt-2">Zero forms filled. Your claim has been auto-processed via DigiLocker.</p>
      
      <div class="tracking-info">
        <span class="tracking-label">Tracking ID</span>
        <span class="tracking-value">CLM-202608-X91M2P</span>
      </div>
      
      <a href="/dashboard" class="btn btn-outline mt-6">Return to Dashboard</a>
    </div>

  </main>
</Layout>

<script>
  document.getElementById('one-click-submit')?.addEventListener('click', () => {
    const claimForm = document.getElementById('claim-form-state');
    const successState = document.getElementById('success-state');
    
    if(claimForm && successState) {
      claimForm.style.display = 'none';
      successState.style.display = 'block';
    }
  });
</script>

<style>
  .claim-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .page-header {
    margin-bottom: 2rem;
  }
  
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  
  .breadcrumbs a {
    color: var(--primary);
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--text-main);
  }
  
  .digilocker-card {
    padding: 0;
    overflow: hidden;
  }

  .digilocker-header {
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dl-icon {
    color: var(--secondary);
    background: var(--success-bg);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .digilocker-header h3 {
    font-size: 1.25rem;
    color: var(--text-main);
  }

  .data-grid {
    padding: 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .data-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .data-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-value {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .amount-card {
    margin: 2rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    color: white;
    padding: 2rem;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .amount-label {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }

  .amount-value {
    font-size: 3rem;
    font-weight: 700;
  }

  .action-section {
    padding: 0 2rem 2rem;
    text-align: center;
  }

  .btn-large {
    font-size: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  
  .w-full {
    width: 100%;
  }
  
  /* Success Step */
  .success-step {
    text-align: center;
    padding: 4rem 2rem;
    animation: fadeIn 0.5s ease;
  }
  
  .success-icon {
    width: 80px;
    height: 80px;
    background: var(--success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  
  .tracking-info {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--background);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .tracking-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .tracking-value {
    font-size: 1.5rem;
    font-family: monospace;
    font-weight: 700;
    color: var(--primary);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
