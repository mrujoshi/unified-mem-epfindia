---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { mockUser } from '../data/mockData';

// Map non-active accounts (index > 0) to previous accounts
const previousAccounts = mockUser.memberIds.slice(1).map(m => ({
  company: m.companyName,
  memberId: m.memberId,
  dateOfExit: m.dateOfExit || 'Not Updated',
  balance: `₹ ${(m.totalEmployeeShare + m.totalEmployerShare).toLocaleString('en-IN')}`
}));
---

<Layout title="Merge PF Accounts">
  <Header />
  
  <main class="transfer-container container">
    <div class="page-header">
      <div class="breadcrumbs">
        <a href="/dashboard">Dashboard</a> &gt; <span>1-Click Merge</span>
      </div>
      <h1>One Member - One EPF Account</h1>
      <p class="text-muted">Your intent: "Merge previous accounts". We found 2 previous accounts linked to your UAN.</p>
    </div>

    <div class="card digilocker-card" id="transfer-form-state">
       <div class="digilocker-header">
         <div class="dl-icon" style="background: var(--primary-light); color: var(--primary);">
           <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"></path><path d="M4 20L21 3"></path><path d="M21 16v5h-5"></path><path d="M15 15l6 6"></path><path d="M4 4l5 5"></path></svg>
         </div>
         <h3>Consolidate PF Accounts (Form 13)</h3>
       </div>
       
       <div class="target-account-section">
         <h4>Target Account (Current Employer)</h4>
         <div class="target-card">
           <div class="company-name">Reliance Industries Ltd.</div>
           <div class="member-id">{mockUser.memberId}</div>
         </div>
       </div>

       <div class="previous-accounts-section">
         <h4>Previous Accounts to Merge</h4>
         <div class="accounts-list">
           {previousAccounts.map((acc, index) => (
             <div class="account-item">
               <div class="checkbox-wrapper">
                 <input type="checkbox" id={`acc-${index}`} checked disabled class="custom-checkbox" />
                 <label for={`acc-${index}`}></label>
               </div>
               <div class="account-details">
                 <div class="company-name">{acc.company}</div>
                 <div class="member-id">{acc.memberId}</div>
                 <div class="exit-date">Date of Exit: {acc.dateOfExit}</div>
               </div>
               <div class="account-balance">
                 {acc.balance}
               </div>
             </div>
           ))}
         </div>
       </div>

       <div class="kyc-banner">
         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
         <span><strong>KYC Verified:</strong> Aadhaar & PAN are verified. <strong>Employer Attestation Skipped.</strong> Automatic transfer enabled.</span>
       </div>

       <div class="action-section">
         <p class="text-sm text-muted mb-4">By clicking confirm, you authorize EPFO to transfer the balances from the selected previous accounts to your current active account.</p>
         <button class="btn btn-primary btn-large w-full" id="one-click-submit">
           Merge & Transfer Funds
         </button>
       </div>
    </div>

    <!-- Success State -->
    <div class="card success-step" id="success-state" style="display: none;">
      <div class="success-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h2>Transfer Request Initiated!</h2>
      <p class="text-muted mt-2">Zero forms filled. Your PF accounts are being consolidated.</p>
      
      <div class="tracking-info">
        <span class="tracking-label">Transfer Tracking ID</span>
        <span class="tracking-value">TRF-202608-A4B9XZ</span>
      </div>
      
      <a href="/dashboard" class="btn btn-outline mt-6">Return to Dashboard</a>
    </div>

  </main>
</Layout>

<script define:vars={{ mockUser }}>
  document.addEventListener('DOMContentLoaded', () => {
    let userStr = localStorage.getItem('epfMockUser');
    if (!userStr) {
      localStorage.setItem('epfMockUser', JSON.stringify(mockUser));
      userStr = JSON.stringify(mockUser);
    }
    const currentUser = JSON.parse(userStr);

    document.getElementById('one-click-submit')?.addEventListener('click', () => {
      const claimForm = document.getElementById('transfer-form-state');
      const successState = document.getElementById('success-state');
      
      if(claimForm && successState) {
        claimForm.style.display = 'none';
        successState.style.display = 'block';

        // Add a new Form-13 claim to localStorage
        const today = new Date().toLocaleDateString('en-GB').replace(/\//g, '-');
        const trackingId = `TRF-${Math.floor(Math.random() * 1000000)}`;
        
        currentUser.claims.unshift({
          trackingId: trackingId,
          formType: "Form-13 (Transfer)",
          submittedDate: today,
          sentToFO: null,
          status: "Under Process",
          remarks: "Pending verification at field office"
        });

        localStorage.setItem('epfMockUser', JSON.stringify(currentUser));

        // Update tracking ID in UI
        const trackingValueEl = document.querySelector('.tracking-value');
        if (trackingValueEl) {
          trackingValueEl.textContent = trackingId;
        }

        // Redirect to track-claim after a short delay so they can read the success message
        setTimeout(() => {
          window.location.href = '/track-claim';
        }, 2000);
      }
    });
  });
</script>

<style>
  .transfer-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .page-header {
    margin-bottom: 2rem;
  }
  
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  
  .breadcrumbs a {
    color: var(--primary);
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--text-main);
  }
  
  .digilocker-card {
    padding: 0;
    overflow: hidden;
  }

  .digilocker-header {
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dl-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .digilocker-header h3 {
    font-size: 1.25rem;
    color: var(--text-main);
  }

  .target-account-section, .previous-accounts-section {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .target-account-section h4, .previous-accounts-section h4 {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .target-card {
    background: var(--success-bg);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .company-name {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text-main);
  }

  .member-id {
    font-family: monospace;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .accounts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .account-item {
    display: flex;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color 0.2s;
  }
  
  .account-item:hover {
    border-color: var(--primary);
  }

  .checkbox-wrapper {
    margin-right: 1.5rem;
  }

  .custom-checkbox {
    width: 20px;
    height: 20px;
    accent-color: var(--primary);
  }

  .account-details {
    flex: 1;
  }

  .exit-date {
    font-size: 0.75rem;
    color: var(--warning);
    margin-top: 0.5rem;
    font-weight: 500;
  }

  .account-balance {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
  }

  .kyc-banner {
    margin: 1.5rem 2rem;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
  }

  .action-section {
    padding: 0 2rem 2rem;
    text-align: center;
  }

  .btn-large {
    font-size: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  
  .w-full {
    width: 100%;
  }
  
  /* Success Step */
  .success-step {
    text-align: center;
    padding: 4rem 2rem;
    animation: fadeIn 0.5s ease;
  }
  
  .success-icon {
    width: 80px;
    height: 80px;
    background: var(--success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  
  .tracking-info {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--background);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .tracking-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .tracking-value {
    font-size: 1.5rem;
    font-family: monospace;
    font-weight: 700;
    color: var(--primary);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
