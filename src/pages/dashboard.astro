---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { mockUser } from '../data/mockData';
---

<Layout title="Dashboard">
  <Header />
  
  <main class="dashboard-container container">
    <div class="welcome-section">
      <h1>Welcome, {mockUser.name}</h1>
      <p class="text-muted">Last successful login: Today at 10:45 AM</p>
    </div>

    <!-- Alerts Row: Nudge + Last Claim Status -->
    <div class="alerts-row">
      <!-- Smart Notification Alert -->
      <div class="smart-alert" id="nudge-alert">
        <div class="alert-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <div class="alert-content">
          <h4>Action Recommended</h4>
          <p>Your employer missed the PF deposit for July 2026. Would you like to send an anonymous nudge?</p>
        </div>
        <button class="btn btn-primary alert-btn" id="send-nudge-btn">Send Nudge</button>
      </div>

      <!-- Last Claim Status Banner -->
      <div class="last-claim-banner" id="last-claim-banner" style="display: none;">
        <div class="claim-banner-icon" id="claim-banner-icon"></div>
        <div class="claim-banner-text">
          <span class="claim-banner-label">Last Claim This Financial Year</span>
          <p id="claim-banner-message" class="claim-banner-message"></p>
        </div>
        <a href="/track-claim" class="btn btn-outline alert-btn" style="white-space: nowrap;">Track Claim</a>
      </div>
    </div>
    
    <div class="dashboard-grid">
      <!-- AI Chat Bar / Search -->
      <section class="card info-card ai-search-card">
        <div class="ai-search-container">
          <div class="ai-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h2>What do you need help with today?</h2>
          <div class="search-wrapper">
            <input type="text" placeholder="e.g., I want to withdraw my PF..." class="ai-input" id="ai-input-field" />
            <div class="search-actions">
              <button class="btn-mic" aria-label="Voice Command" title="Speak your request" id="mic-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mic-icon"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
              </button>
              <button class="btn btn-primary ai-submit" id="ai-submit-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              </button>
            </div>
          </div>
          <div class="suggestion-chips">
            <a href="/partial-claim" class="chip">Withdraw Partial PF</a>
            <a href="/claim" class="chip">Withdraw Full PF</a>
            <a href="/passbook" class="chip">Check my balance</a>
            <a href="/track-claim" class="chip">Track claim status</a>
          </div>
        </div>
      </section>
      
      <!-- Member Profile Card -->
      <section class="card profile-card">
        <div class="card-header">
          <h3>Member Profile</h3>
          <span class="badge badge-success">Active</span>
        </div>
        <div class="profile-details">
          <div class="detail-row">
            <span class="detail-label">UAN</span>
            <span class="detail-value font-semibold">{mockUser.uan}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value">{mockUser.name}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Date of Birth</span>
            <span class="detail-value">{mockUser.dob}</span>
          </div>
        </div>
        
        <div class="kyc-status mt-4">
          <h4>KYC Status</h4>
          <div class="kyc-grid">
            <div class="kyc-item">
              <span class="kyc-label">Aadhaar</span>
              <span class={`status-indicator status-${mockUser.aadhaarStatus.toLowerCase()}`}>
                {mockUser.aadhaarStatus}
              </span>
            </div>
            <div class="kyc-item">
              <span class="kyc-label">PAN</span>
              <span class={`status-indicator status-${mockUser.panStatus.toLowerCase()}`}>
                {mockUser.panStatus}
              </span>
            </div>
            <div class="kyc-item">
              <span class="kyc-label">Bank</span>
              <span class={`status-indicator status-${mockUser.bankStatus.toLowerCase()}`}>
                {mockUser.bankStatus}
              </span>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Unified Passbook Access Card -->
      <section class="card passbook-promo-card">
        <div class="promo-content">
          <div class="promo-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <div class="promo-text">
            <h3>Unified Passbook</h3>
            <p>View your complete contribution history across all your previous and current employers seamlessly in one place.</p>
            <div style="margin-bottom: 1.5rem;">
              <span class="text-sm" style="opacity: 0.9;">Total Estimated Balance</span>
              <div id="dashboard-unified-balance" style="font-size: 2rem; font-weight: 700;">₹ 0</div>
            </div>
          </div>
          <a href="/passbook" class="btn btn-primary view-passbook-btn">
            View Full Passbook
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script define:vars={{ mockUser }}>
  document.addEventListener('DOMContentLoaded', () => {
    // LocalStorage sync for widgets
    let userStr = localStorage.getItem('epfMockUser');
    if (!userStr) {
      localStorage.setItem('epfMockUser', JSON.stringify(mockUser));
      userStr = JSON.stringify(mockUser);
    }
    const currentUser = JSON.parse(userStr);

    // Total Balance
    const totalBalance = currentUser.memberIds.reduce((sum, m) => sum + m.totalEmployeeShare + m.totalEmployerShare + m.totalPensionShare, 0);
    const balanceEl = document.getElementById('dashboard-unified-balance');
    if (balanceEl) {
      balanceEl.textContent = `₹ ${totalBalance.toLocaleString('en-IN')}`;
    }

    // Last Claim This Financial Year Banner
    const currentFYStart = new Date().getMonth() >= 3 ? 
      new Date(new Date().getFullYear(), 3, 1) :
      new Date(new Date().getFullYear() - 1, 3, 1);
    
    const lastFYClaim = currentUser.claims.find(claim => {
      // Parse date like "12-Aug-2026" or "27-08-2026"
      const parts = claim.submittedDate.split('-');
      let claimDate;
      if (parts.length === 3) {
        // Try DD-MMM-YYYY format
        claimDate = new Date(claim.submittedDate);
        if (isNaN(claimDate)) {
          // Try DD-MM-YYYY
          claimDate = new Date(`${parts[2]}-${parts[1]}-${parts[0]}`);
        }
      }
      return claimDate >= currentFYStart;
    });
    
    const banner = document.getElementById('last-claim-banner');
    const bannerMsg = document.getElementById('claim-banner-message');
    const bannerIcon = document.getElementById('claim-banner-icon');
    
    if (lastFYClaim && banner && bannerMsg) {
      const statusEmoji = lastFYClaim.status === 'Settled' ? '✅' : (lastFYClaim.status === 'Rejected' ? '❌' : '⏳');
      const statusVerb = lastFYClaim.status === 'Settled' ? 'has been settled' : (lastFYClaim.status === 'Rejected' ? 'was rejected' : 'is under process');
      bannerIcon.textContent = statusEmoji;
      bannerMsg.textContent = `Your last claim (${lastFYClaim.formType}) ${statusVerb}.`;
      banner.classList.add(`banner-${lastFYClaim.status.toLowerCase().replace(' ', '-')}`);
      banner.style.display = 'flex';
    }

    // Send Nudge Button
    const nudgeBtn = document.getElementById('send-nudge-btn');
    const nudgeAlert = document.getElementById('nudge-alert');
    nudgeBtn?.addEventListener('click', () => {
      nudgeBtn.disabled = true;
      nudgeBtn.textContent = 'Sending...';
      setTimeout(() => {
        nudgeAlert.style.background = 'var(--success-bg)';
        nudgeAlert.style.borderColor = 'var(--success)';
        nudgeAlert.querySelector('.alert-icon').style.color = 'var(--success)';
        nudgeAlert.querySelector('.alert-icon svg').innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
        nudgeAlert.querySelector('h4').textContent = 'Nudge Sent Anonymously!';
        nudgeAlert.querySelector('p').textContent = 'EPFO has been notified. Your employer will receive a compliance reminder for July 2026. Your identity is protected.';
        nudgeBtn.textContent = '✓ Done';
        nudgeBtn.style.background = 'var(--success)';
        nudgeBtn.style.border = 'none';
      }, 1200);
    });

    const aiInput = document.getElementById('ai-input-field');
    const aiSubmit = document.getElementById('ai-submit-btn');

    const handleSubmit = () => {
      if (aiInput && aiInput.value.trim().length > 0) {
        const text = aiInput.value.toLowerCase();
        
        // Simple Intent Routing
        const isTransfer = text.includes('merge') || text.includes('transfer') || text.includes('consolidate') || text.includes('previous');
        const isTrack = text.includes('track') || text.includes('status') || text.includes('where is');
        const isPassbook = text.includes('passbook') || text.includes('balance') || text.includes('check');
        
        const isPartialClaim = text.includes('partial') || text.includes('advance') || text.includes('loan') || text.includes('illness') || text.includes('marriage') || text.includes('education');
        const isFullClaim = text.includes('full') || text.includes('settle') || text.includes('close account');
        const isGenericWithdraw = text.includes('withdraw') || text.includes('claim') || text.includes('money');
        
        if (isTrack) {
          window.location.href = '/track-claim';
        } else if (isPassbook) {
          window.location.href = '/passbook';
        } else if (isTransfer) {
          window.location.href = '/transfer';
        } else if (isPartialClaim) {
          window.location.href = '/partial-claim';
        } else if (isFullClaim) {
          window.location.href = '/claim';
        } else if (isGenericWithdraw) {
          alert("Did you mean a 'full withdrawal' or a 'partial advance'? Please clarify!");
        } else {
          alert("I didn't quite catch that. Try asking to 'withdraw PF', 'merge accounts', 'track status', or 'show passbook'.");
        }
      }
    };

    aiSubmit?.addEventListener('click', handleSubmit);
    
    aiInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        handleSubmit();
      }
    });

    // Listen for speech transcription (either from global or self)
    window.addEventListener('speech-transcribed', (e) => {
      if (aiInput && e.detail && e.detail.text) {
        aiInput.value = e.detail.text;
        // Add a small delay so user can read what was transcribed before redirecting
        setTimeout(handleSubmit, 1500);
      }
    });

    // Sarvam API Logic
    const micBtn = document.getElementById('mic-btn');
    const langSelect = document.getElementById('lang-select');
    let mediaRecorder = null;
    let audioChunks = [];
    let isRecording = false;

    const sarvamLangMap = {
      'en': 'en-IN', 'hi': 'hi-IN', 'mr': 'mr-IN', 'ta': 'ta-IN', 'te': 'te-IN',
      'kn': 'kn-IN', 'ml': 'ml-IN', 'gu': 'gu-IN', 'pa': 'pa-IN', 'bn': 'bn-IN',
      'as': 'as-IN', 'or': 'or-IN', 'mwr': 'hi-IN', 'bgc': 'hi-IN'
    };

    micBtn?.addEventListener('click', async () => {
      if (!isRecording) {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(stream);
          audioChunks = [];

          mediaRecorder.addEventListener('dataavailable', event => {
            audioChunks.push(event.data);
          });

          mediaRecorder.addEventListener('stop', async () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
            stream.getTracks().forEach(track => track.stop());
            
            const selectedLang = langSelect ? langSelect.value : 'hi';
            const sarvamLang = sarvamLangMap[selectedLang] || 'hi-IN';
            
            const formData = new FormData();
            formData.append('file', audioBlob, 'speech.wav');
            formData.append('model', 'saaras:v3');
            formData.append('language_code', sarvamLang);
            
            micBtn.classList.add('loading');
            
            try {
              const response = await fetch('https://api.sarvam.ai/speech-to-text', {
                method: 'POST',
                headers: { 'api-subscription-key': 'sk_huz7ih86_gItddaVrKj7HHb5pYjb1MGaR' },
                body: formData
              });
              const result = await response.json();
              if (result && result.transcript) {
                window.dispatchEvent(new CustomEvent('speech-transcribed', { detail: { text: result.transcript } }));
              } else {
                alert("Speech unrecognized. Please try again.");
              }
            } catch (error) {
              alert("Error connecting to Speech-to-Text service.");
            } finally {
              micBtn.classList.remove('loading');
            }
          });

          mediaRecorder.start();
          isRecording = true;
          micBtn.classList.add('recording');
        } catch (err) {
          alert("Microphone access denied or unavailable.");
        }
      } else {
        mediaRecorder.stop();
        isRecording = false;
        micBtn.classList.remove('recording');
      }
    });
  });
</script>

<style>
  .dashboard-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  
  .welcome-section {
    margin-bottom: 2rem;
  }
  
  .welcome-section h1 {
    font-size: 1.875rem;
    color: var(--text-main);
  }
  
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
  }
  
  .card-header h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }
  
  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .badge-success {
    background: var(--success-bg);
    color: var(--success);
  }
  
  .profile-card {
    grid-column: span 8;
  }
  
  .profile-details {
    padding: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .detail-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  
  .detail-value {
    font-size: 1.125rem;
    color: var(--text-main);
  }
  
  .kyc-status {
    padding: 0 1.5rem 1.5rem;
  }
  
  .kyc-status h4 {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .kyc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  
  .kyc-item {
    background: var(--background);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
  }
  
  .kyc-label {
    font-weight: 500;
    font-size: 0.875rem;
  }
  
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .status-verified {
    background: var(--success-bg);
    color: var(--success);
  }
  
  .status-verified::before {
    content: '✓';
  }
  
  .passbook-promo-card {
    grid-column: span 4;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    color: white;
    border: none;
    position: relative;
    overflow: hidden;
  }
  
  .passbook-promo-card::after {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 150px;
    height: 150px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }
  
  .promo-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    z-index: 1;
  }
  
  .promo-icon {
    background: rgba(255, 255, 255, 0.2);
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  
  .promo-text h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  
  .promo-text p {
    font-size: 0.875rem;
    opacity: 0.9;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  .view-passbook-btn {
    margin-top: auto;
    background: white;
    color: var(--primary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .view-passbook-btn:hover {
    background: var(--primary-light);
    box-shadow: none;
    transform: translateX(4px);
  }
  
  .info-card {
    grid-column: span 12;
  }
  
  /* Alerts Row: Nudge + Last Claim Status */
  .alerts-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* Smart Alert Styles */
  .smart-alert {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: var(--warning-bg);
    border: 1px solid var(--warning);
    border-radius: var(--radius-lg);
    padding: 1.25rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  /* Last Claim Banner */
  .last-claim-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-radius: var(--radius-lg);
    padding: 1.25rem 2rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .last-claim-banner.banner-settled {
    background: var(--success-bg);
    border-color: var(--success);
  }

  .last-claim-banner.banner-under-process {
    background: #eff6ff;
    border-color: var(--primary);
  }

  .last-claim-banner.banner-rejected {
    background: var(--danger-bg);
    border-color: var(--danger);
  }

  .claim-banner-icon {
    font-size: 2rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .claim-banner-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .claim-banner-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .claim-banner-message {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
  }

  .alert-icon {
    color: var(--warning);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .alert-content {
    flex: 1;
  }

  .alert-content h4 {
    color: #92400e;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .alert-content p {
    color: #b45309;
    font-size: 0.95rem;
    margin: 0;
  }

  .alert-btn {
    background: #d97706;
    border: none;
    padding: 0.5rem 1.25rem;
  }

  .alert-btn:hover {
    background: #b45309;
  }

  /* AI Search Card Styles */
  .ai-search-card {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(to bottom, #ffffff, #f8fafc);
  }

  .ai-search-container {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-icon {
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .ai-search-container h2 {
    font-size: 1.75rem;
    color: var(--text-main);
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .search-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .ai-input {
    width: 100%;
    padding: 1.25rem 7rem 1.25rem 1.5rem;
    font-size: 1.125rem;
    border: 2px solid var(--border);
    border-radius: 9999px;
    outline: none;
    transition: all 0.3s;
    box-shadow: var(--shadow-sm);
  }

  .ai-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-light);
  }

  .search-actions {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .btn-mic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: var(--text-muted);
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-mic:hover {
    color: var(--primary);
    background: var(--primary-light);
  }

  .btn-mic.recording {
    background: var(--danger-bg);
    color: var(--danger);
    animation: pulse-red 1.5s infinite;
  }
  
  .btn-mic.loading {
    opacity: 0.7;
    pointer-events: none;
    animation: pulse-blue 1s infinite;
