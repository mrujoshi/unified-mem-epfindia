---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { mockUser } from '../data/mockData';
---

<Layout title="Track Claim Status">
  <Header />
  
  <main class="track-claim-container container">
    <div class="page-header">
      <div class="breadcrumbs">
        <a href="/dashboard">Dashboard</a> &gt; <span>Track Claim Status</span>
      </div>
      <h1>Track Claim Status</h1>
      <p class="text-muted">Check the status of your online withdrawal or transfer requests</p>
    </div>
    
    <div class="card table-card">
      <div class="card-header">
        <h3>Claim History</h3>
      </div>
      <div class="table-responsive">
        <table class="claim-table">
          <thead>
            <tr>
              <th>Tracking ID</th>
              <th>Form Type</th>
              <th>Submitted To Portal</th>
              <th>Sent To Field Office</th>
              <th>Current Status</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody id="claims-table-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
    </div>
    
    <div class="timeline-section card" id="timeline-section" style="display: none;">
      <div class="card-header">
        <h3 id="timeline-title">Live Tracking: </h3>
      </div>
      <div class="timeline-body">
        <div class="timeline" id="timeline-container">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ mockUser }}>
  document.addEventListener('DOMContentLoaded', () => {
    let userStr = localStorage.getItem('epfMockUser');
    if (!userStr) {
      localStorage.setItem('epfMockUser', JSON.stringify(mockUser));
      userStr = JSON.stringify(mockUser);
    }
    const currentUser = JSON.parse(userStr);
    
    const tableBody = document.getElementById('claims-table-body');
    const timelineSection = document.getElementById('timeline-section');
    const timelineTitle = document.getElementById('timeline-title');
    const timelineContainer = document.getElementById('timeline-container');
    
    // Render Table
    tableBody.innerHTML = currentUser.claims.map(claim => {
      const statusClass = claim.status.toLowerCase().replace(' ', '-');
      let tooltip = '';
      if (claim.status === 'Under Process') {
        tooltip = 'title="Initiated claims are expected to be settled within 2 weeks"';
      }
      return `
        <tr>
          <td><strong>${claim.trackingId}</strong></td>
          <td>${claim.formType}</td>
          <td>${claim.submittedDate}</td>
          <td>${claim.sentToFO || '-'}</td>
          <td>
            <span class="status-badge status-${statusClass}" ${tooltip}>
              ${claim.status} ${claim.status === 'Under Process' ? 'ℹ️' : ''}
            </span>
          </td>
          <td class="text-muted">${claim.remarks || '-'}</td>
        </tr>
      `;
    }).join('');

    // Render Timeline (show latest claim)
    if (currentUser.claims.length > 0) {
      const latestClaim = currentUser.claims[0];
      timelineSection.style.display = 'block';
      timelineTitle.textContent = `Live Tracking: ${latestClaim.trackingId}`;
      
      const isUnderProcess = latestClaim.status === 'Under Process';
      const isSettled = latestClaim.status === 'Settled';
      const isRejected = latestClaim.status === 'Rejected';

      timelineContainer.innerHTML = `
        <div class="timeline-step completed">
          <div class="step-icon">✓</div>
          <div class="step-content">
            <h4>Claim Submitted</h4>
            <p>${latestClaim.submittedDate}</p>
          </div>
        </div>
        
        <div class="timeline-step ${latestClaim.sentToFO ? 'completed' : 'active'}">
          <div class="step-icon">${latestClaim.sentToFO ? '✓' : '⟳'}</div>
          <div class="step-content">
            <h4>Sent to Field Office</h4>
            <p>${latestClaim.sentToFO || 'Pending'}</p>
          </div>
        </div>
        
        <div class="timeline-step ${isSettled || isRejected ? 'completed' : (isUnderProcess ? 'active' : 'pending')}">
          <div class="step-icon">${isSettled || isRejected ? '✓' : (isUnderProcess ? '⟳' : '⏳')}</div>
          <div class="step-content">
            <h4>Under Process</h4>
            <p>${isSettled || isRejected ? 'Completed' : 'Expected resolution in 3-5 working days.'}</p>
          </div>
        </div>
        
        <div class="timeline-step ${isSettled ? 'completed' : (isRejected ? 'rejected' : 'pending')}">
          <div class="step-icon">${isSettled || isRejected ? (isSettled ? '✓' : '✗') : '⏳'}</div>
          <div class="step-content">
            <h4 style="${isRejected ? 'color: var(--danger)' : ''}">${isSettled ? 'Settled' : (isRejected ? 'Rejected' : 'Settled / Rejected')}</h4>
            <p>${latestClaim.remarks || 'Pending'}</p>
          </div>
        </div>
      `;

      // 15 Second Magic Settlement for Form-13
      if (latestClaim.formType.includes('Form-13') && latestClaim.status === 'Under Process') {
        setTimeout(() => {
          // Update claim status
          latestClaim.status = 'Settled';
          latestClaim.remarks = 'Transfer completed successfully';
          latestClaim.sentToFO = latestClaim.submittedDate; // Assume sent same day
          
          // Fund transfer logic
          let totalEmployeeToAdd = 0;
          let totalEmployerToAdd = 0;
          let totalPensionToAdd = 0;
          
          for (let i = 1; i < currentUser.memberIds.length; i++) {
            totalEmployeeToAdd += currentUser.memberIds[i].totalEmployeeShare;
            totalEmployerToAdd += currentUser.memberIds[i].totalEmployerShare;
            totalPensionToAdd += currentUser.memberIds[i].totalPensionShare;
            
            // Zero out old accounts
            currentUser.memberIds[i].totalEmployeeShare = 0;
            currentUser.memberIds[i].totalEmployerShare = 0;
            currentUser.memberIds[i].totalPensionShare = 0;
          }
          
          // Add to current (index 0)
          currentUser.memberIds[0].totalEmployeeShare += totalEmployeeToAdd;
          currentUser.memberIds[0].totalEmployerShare += totalEmployerToAdd;
          currentUser.memberIds[0].totalPensionShare += totalPensionToAdd;
          
          localStorage.setItem('epfMockUser', JSON.stringify(currentUser));
          
          // Alert and reload
          alert("Demo Magic: Transfer Settled in 15 seconds! Funds moved to current account.");
          window.location.reload();
        }, 15000); // 15 seconds
      }
    }
  });
</script>

<style>
  .track-claim-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  
  .page-header {
    margin-bottom: 2rem;
  }
  
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  
  .breadcrumbs a {
    color: var(--primary);
  }
  
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  
  .page-header h1 {
    font-size: 1.875rem;
    color: var(--text-main);
  }
  
  .table-card {
    margin-bottom: 2rem;
    overflow: hidden;
  }
  
  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }
  
  .card-header h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }
  
  .table-responsive {
    overflow-x: auto;
  }
  
  .claim-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .claim-table th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--border);
  }
  
  .claim-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-main);
    font-size: 0.95rem;
  }
  
  .claim-table tr:last-child td {
    border-bottom: none;
  }
  
  .claim-table tr:hover td {
    background: var(--background);
  }
  
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: help;
  }
  
  .status-under-process {
    background: var(--warning-bg);
    color: var(--warning);
  }
  
  .status-settled {
    background: var(--success-bg);
    color: var(--success);
  }
  
  .status-rejected {
    background: var(--danger-bg);
    color: var(--danger);
  }
  
  .timeline-section {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .timeline-body {
    padding: 2rem;
  }
  
  .timeline {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 2px;
    background: var(--border);
  }
  
  .timeline-step {
    display: flex;
    margin-bottom: 2rem;
    position: relative;
  }
  
  .timeline-step:last-child {
    margin-bottom: 0;
  }
  
  .step-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.2rem;
    z-index: 1;
    flex-shrink: 0;
  }
  
  .step-content {
    margin-left: 1.5rem;
    padding-top: 0.5rem;
  }
  
  .step-content h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  
  .step-content p {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  
  .timeline-step.completed .step-icon {
    background: var(--success);
    color: white;
  }
  
  .timeline-step.completed .step-content h4 {
    color: var(--success);
  }
  
  .timeline-step.active .step-icon {
    background: var(--primary);
    color: white;
    box-shadow: 0 0 0 4px var(--primary-light);
  }
  
  .timeline-step.active .step-content h4 {
    color: var(--primary);
  }
  
  .timeline-step.pending .step-icon {
    background: var(--background);
    border: 2px solid var(--border);
    color: var(--text-muted);
  }
  
  .timeline-step.pending .step-content h4 {
    color: var(--text-muted);
  }
  
  .timeline-step.rejected .step-icon {
    background: var(--danger);
    color: white;
  }
</style>
